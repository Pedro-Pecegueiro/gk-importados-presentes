{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gk-importados-presentes",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "gkpresentes.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.gkpresentes.com.br",
      "custom_domain": true
    }
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gk-importados-db",
      "database_id": "cf7bf247-e193-485a-9b24-91b240f87139",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "gk-importados-assets"
    }
  ],
  "observability": {
    "enabled": true
  }
}
